PORT=9113

# —— Admin 主库（default 连接）——
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3093
DB_USERNAME=root
DB_PASSWORD=example
DB_DATABASE=dnhyxc_admin_db
DB_SYNC=true
DB_POOL_SIZE=10

# —— AI 业务库（ai 连接，对接 dnhyxc-ai）——
# 对接 dnhyxc-ai 业务库（需其 MySQL 3090 已启动）
AI_DB_ENABLED=true
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3090
AI_DB_USERNAME=root
AI_DB_PASSWORD=example
AI_DB_DATABASE=dnhyxc_ai_db
AI_DB_POOL_SIZE=5

LOG_ON=true
LOG_LEVEL=info

# JWT
SECRET=change-me-to-a-long-random-secret

# Redis（可选；不配则用内存缓存）
REDIS_URL=redis://127.0.0.1:6379

# 种子管理员（仅首次无用户时创建）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@dnhyxc.cn
