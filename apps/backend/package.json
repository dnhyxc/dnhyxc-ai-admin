		"passport-jwt": "^4.0.1",
		"reflect-metadata": "^0.2.2",
		"request-ip": "^3.3.0",
		"rxjs": "^7.8.1",
		"svg-captcha": "^1.4.0",
		"swagger-ui-express": "^5.0.1",
		"typeorm": "^0.3.28",
		"winston": "^3.19.0",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
